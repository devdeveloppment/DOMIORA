# --- Core ---
SECRET_KEY=change-this-to-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
# Leave unset to use local SQLite automatically.
DATABASE_URL=postgres://domiora:domiora@localhost:5432/domiora

# --- Email / SMTP ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=DOMIORA <contact@domiora.com>
ADMIN_NOTIFICATION_EMAIL=contact@domiora.com

# --- AI Assistant (optional) ---
# Leave empty locally unless the Django assistant is explicitly enabled.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Optional fallback provider for the Django assistant / AI search
ANTHROPIC_MODEL=claude-haiku-4-5
# Rate limit for AI features (requests per window, per user or IP)
AI_RATE_LIMIT=20
AI_RATE_WINDOW_SECONDS=60

# --- Remote MCP / Claude service (configure on the MCP host only) ---
# Never put a real value in this example file or in a client config.
ANTHROPIC_API_KEY=
MCP_ACCESS_TOKEN=
MCP_PUBLIC_URL=https://domiora-mcp.onrender.com/mcp
MCP_ISSUER_URL=https://auth.example.com/
CLAUDE_MODEL=claude-sonnet-4-20250514
ANTHROPIC_TIMEOUT_SECONDS=60
MCP_MAX_PROMPT_CHARS=12000
MCP_MAX_CONTEXT_CHARS=30000
MCP_MAX_TOKENS=4096
MCP_RATE_LIMIT=30
MCP_RATE_WINDOW_SECONDS=60


# --- Media storage (production) ---
# Cloudinary: images + virtual tour videos (uploaded with resource_type "video").
# Leave empty locally to store media on disk.
CLOUDINARY_URL=

# --- Async tasks: Celery + Redis (virtual tour generation) ---
# Production (Render): Render Key Value connection string, shared by the web service and the worker.
# Render free plan: the Celery worker runs inside the web service container (see start.sh).
# Leave empty locally: a filesystem broker is used (same machine only); start a worker with
#   celery -A config worker --pool=solo --loglevel=info   (Windows)
REDIS_URL=
# Dev only: run tasks inline without a worker (blocks the request). Never in production.
CELERY_TASK_ALWAYS_EAGER=False

# --- Virtual tour video ---
VIRTUAL_TOUR_RESOLUTION=1280x720
VIRTUAL_TOUR_FPS=25
VIRTUAL_TOUR_SOFT_TIME_LIMIT=900
# Optional explicit ffmpeg binary (default: ffmpeg on PATH, then the imageio-ffmpeg binary)
FFMPEG_BINARY=
# Background music: disabled by default (no track shipped). Path to a royalty-free audio file.
VIRTUAL_TOUR_MUSIC_PATH=

# --- Security (production) ---
CSRF_TRUSTED_ORIGINS=https://your-domain.com
SECURE_SSL_REDIRECT=True






